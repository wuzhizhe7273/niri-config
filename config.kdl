// =============================================================================
// Niri 主配置文件 — 模块化组织
// Niri Main Config — Modular Structure
//
// 每个 include 文件负责一个独立的功能领域。
// Each included file manages a single concern.
//
// 加载顺序决定覆盖关系：后加载的同名配置项会覆盖先加载的。
// Load order: later files override earlier ones for duplicate settings.
// =============================================================================

include "settings.kdl"       // 基础设置 / Settings (截图、光标、环境变量、调试)
include "input.kdl"          // 输入设备 / Input (键盘、触摸板、鼠标)
include "layout.kdl"         // 布局结构 / Layout (间距、列宽、焦点环、阴影)
include "binds.kdl"          // 快捷键 / Key bindings
include "startup.kdl"        // 自启动 / Auto-start
include "window-rules.kdl"   // 窗口规则 / Window rules
include "layer-rules.kdl"    // 图层规则 / Layer-shell rules
include "noctalia.kdl"       // Noctalia 主题颜色（自动生成，请勿手动编辑）/ Auto-generated theme

// noctalia.kdl 放在最后，确保颜色覆盖 layout.kdl 中的结构定义。
// noctalia.kdl is last so colors override structural layout defaults.
include "./animations/burn-ashes.kdl"
