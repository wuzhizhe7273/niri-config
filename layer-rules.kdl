// =============================================================================
// 图层规则 / Layer-shell Rules
//
// Layer-shell 是 Wayland 协议中用于通知面板、叠加层、壁纸等
// 特殊表面的协议，它们不受正常窗口管理控制。
// Layer-shell is a Wayland protocol for special surfaces like
// notification panels, overlays, and wallpapers.
//
// place-within-backdrop: 将图层放入总览模式和工作区切换时的背景遮罩中。
// 仅对忽略独占区的 "background" 层表面生效（如壁纸工具）。
// place-within-backdrop: places the surface into the backdrop visible in
// overview and between workspaces. Only for "background" layers that
// ignore exclusive zones (e.g., wallpaper tools).
// =============================================================================

layer-rule {
    match namespace="^noctalia-backdrop*"
    place-within-backdrop true
}

layer-rule {
    match namespace="linux-wallpaperengine"
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|osd)$"
    background-effect {
        xray false
    }
}
