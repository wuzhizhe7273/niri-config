// =============================================================================
// 窗口规则 / Window Rules
//
// 根据应用 ID 和窗口标题匹配特定窗口，并应用自定义外观/行为规则。
// Match specific windows by app-id and title, then apply custom appearance/behavior.
//
// 匹配字段 / Matching fields:
//   app-id — Wayland/X11 应用标识符，支持正则 r#"..."#
//   title  — 窗口标题，支持正则
//
// 可用选项 / Available options:
//   open-floating                — 以浮动模式启动
//   default-floating-position    — 浮动窗口默认位置
//   opacity                      — 透明度 (0.0 = 全透明, 1.0 = 完全不透明)
//   draw-border-with-background  — 是否用窗口背景色填充边框
//   geometry-corner-radius       — 圆角半径（像素）
//   clip-to-geometry             — 裁剪内容到圆角边界
//   block-out-from               — 阻止 screencast/screen-capture 捕获
//   background-effect            — 背景效果（blur/xray）
// =============================================================================

// ── 全局默认 / Global Defaults ──
// 应用于所有未被子规则覆盖的窗口
// Applied to all windows unless overridden by more specific rules
window-rule {
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
    background-effect {
        blur true
        xray false
    }
}

// ── Rio 终端 / Rio Terminal ──
window-rule {
    match app-id="rio"
    background-effect {
        xray true
    }
}

// ── Firefox ──
window-rule {
    match app-id=r#"firefox$"#
    match title="^Firefox$"
    opacity 0.9
}

// ── Firefox 画中画 / Firefox Picture-in-Picture ──
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id=r#"firefox$"# title="^画中画"
    match app-id=r#"firefox$"# title="^画中画播放器"
    match app-id=r#"firefox$"# title=".*[Pp]icture.*[Ii]n.*[Pp]icture.*"
    open-floating true
}

// ── 邮件客户端 / Email Clients ──
window-rule {
    match app-id="org.mozilla.Thunderbird"
    match app-id="BlueMail"
    opacity 0.85
}

// ── 密码管理器 / Password Managers ──
// 阻止录屏/截图捕获密码内容
// Prevent screencast/screenshot tools from capturing password content
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screencast"
    opacity 0.8
}

// ── Visual Studio Code ──
window-rule {
    match app-id="code"
    opacity 0.8
}

// ── JetBrains Toolbox ──
window-rule {
    match app-id="jetbrains-toolbox"
    opacity 0.9
    default-floating-position x=0 y=16 relative-to="top-right"
}

// ── Mihomo Party ──
window-rule {
    match app-id="mihomo-party"
    match title="Clash Party"
    opacity 0.8
}
window-rule {
    match app-id="mihomo-party" title="^Clash Party Floating$"
    default-floating-position x=0 y=16 relative-to="top-right"
    opacity 0.7
}

// ── Waylyrics (桌面歌词 / Desktop Lyrics) ──
window-rule {
    match app-id="waylyrics"
    open-floating true
}

// ── Cockpit Client ──
window-rule {
    match app-id="org.cockpit_project.CockpitClient"
    opacity 0.75
}

// ── Foliate (电子书阅读器 / eBook Reader) ──
window-rule {
    match app-id="com.github.johnfactotum.Foliate"
    opacity 0.8
}

// ── Skills Manager ──
window-rule {
    match app-id="skills-manager"
    opacity 0.85
}

// ── Noctalia Settings ──
window-rule {
    match app-id="dev.noctalia.Noctalia.Settings"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}
